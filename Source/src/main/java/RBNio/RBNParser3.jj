TOKEN : {
    /* Windows: e.g. C:\dir\file.ext
       or   Unix:   /home/user/file.ext
       (no spaces or brackets allowed inside) */
    < Path:
      (
         ( ["A"-"Z","a"-"z"] ":" ( ["\\","/","a"-"z","A"-"Z","0"-"9",".","_","-"] )+ )
       | ( "/" (~[" ", "\t", "\r", "\n", "[", "]"])+ )
      )
    >
}


